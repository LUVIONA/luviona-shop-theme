{%- comment -%}
  LUVIONA – redaktioneller Hero: Text auf Creme, Bild im Anschnitt. Mobil Bild oben, Text darunter.
{%- endcomment -%}
{% render 'luviona-section-padding', section: section %}
<section class="luviona-hero luviona-hero--{{ section.settings.layout }} color-{{ section.settings.color_scheme }} gradient">
  <div class="luviona-hero__media{% if section.settings.image == blank and section.settings.luviona_asset != blank %} luviona-asset-media{% endif %}">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 990px) 58vw, 100vw', fetchpriority: 'high', class: 'luviona-hero__img' }}
    {%- elsif section.settings.luviona_asset != blank -%}
      {% render 'luviona-asset-image', name: section.settings.luviona_asset, alt: section.settings.image_alt, sizes: '(min-width: 990px) 58vw, 100vw', eager: true, class: 'luviona-hero__img' %}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="luviona-hero__content">
    <div class="luviona-hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="luviona-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="luviona-hero__heading">{{ section.settings.heading }}</h1>
      <span class="luviona-hero__rule" aria-hidden="true"></span>
      {%- if section.settings.text != blank -%}
        <div class="luviona-hero__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="luviona-hero__actions">
        {%- if section.settings.button_label_1 != blank -%}
          <a class="button" href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}">{{ section.settings.button_label_1 | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="luviona-link-arrow" href="{{ section.settings.button_link_2 }}">{{ section.settings.button_label_2 | escape }}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.footnote != blank -%}
        <p class="luviona-hero__footnote">{{ section.settings.footnote | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LUVIONA: Hero",
  "tag": "div",
  "class": "section luviona-hero-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "select", "id": "luviona_asset", "label": "Mitgeliefertes Bild (wenn oben keins gewählt)", "options": [ { "value": "", "label": "Keins" }, { "value": "luviona-hero", "label": "Match Point Kette auf Satin" }, { "value": "luviona-story", "label": "Court Classic am Handgelenk" } ], "default": "luviona-hero" },
    { "type": "text", "id": "image_alt", "label": "Alt-Text", "default": "Match Point Kette goldfarben mit Tennisschläger-Anhänger, Tragebild auf Satin" },
    { "type": "select", "id": "layout", "label": "Anordnung (Desktop)", "options": [ { "value": "text-left", "label": "Text links, Bild rechts" }, { "value": "text-right", "label": "Bild links, Text rechts" } ], "default": "text-left" },
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "Court Style Accessories" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift (kursiv möglich)", "default": "Dein Spiel. <em>Dein Style.</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Schmuck und Taschen-Charms für alle, die den Court lieben.</p>" },
    { "type": "text", "id": "button_label_1", "label": "Button 1", "default": "Kollektion entdecken" },
    { "type": "url", "id": "button_link_1", "label": "Link 1" },
    { "type": "text", "id": "button_label_2", "label": "Link 2 (Textlink)", "default": "Love Charm" },
    { "type": "url", "id": "button_link_2", "label": "Link 2" },
    { "type": "text", "id": "footnote", "label": "Fußzeile", "default": "Versandkostenfrei in Deutschland · 14 Tage Widerruf" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand oben", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand unten", "default": 0 }
  ],
  "presets": [ { "name": "LUVIONA: Hero" } ]
}
{% endschema %}
