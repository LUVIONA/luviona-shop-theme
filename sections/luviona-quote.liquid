{%- comment -%} LUVIONA – Markenversprechen / Zitat in großer Serifenschrift. {%- endcomment -%}
{% render 'luviona-section-padding', section: section %}
<div class="luviona-quote color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width page-width--narrow center">
    {% render 'luviona-ornament' %}
    <blockquote class="luviona-quote__text">{{ section.settings.quote }}</blockquote>
    {%- if section.settings.attribution != blank -%}<p class="luviona-eyebrow luviona-quote__by">{{ section.settings.attribution | escape }}</p>{%- endif -%}
    {%- if section.settings.link_label != blank -%}<a class="luviona-link-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "LUVIONA: Zitat",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "quote",
      "label": "Text",
      "default": "Schmuck, der nach <em>Sommer auf dem Sandplatz</em> aussieht."
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Zeile darunter",
      "default": "LUVIONA"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Linktext"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "LUVIONA: Zitat"
    }
  ]
}
{% endschema %}
