{%- comment -%}
  LUVIONA – Vertrauensleiste (Kostenloser Versand · Versand aus Deutschland · 14 Tage Widerruf · Geschenkverpackung).
  Nur belegbare Aussagen verwenden – keine Superlative, keine Verknappung.
{%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="luviona-trust color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_borders %} luviona-trust--bordered{% endif %} section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="luviona-eyebrow center">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="luviona-trust__list" role="list">
      {%- for block in section.blocks -%}
        <li
          class="luviona-trust__item{% if section.settings.layout == 'row' %} luviona-trust__item--row{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          <span class="luviona-trust__icon">{% render 'luviona-icon', icon: block.settings.icon %}</span>
          <div>
            {%- if block.settings.link != blank -%}
              <p class="luviona-trust__title"><a class="link" href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a></p>
            {%- else -%}
              <p class="luviona-trust__title">{{ block.settings.title | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="luviona-trust__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "LUVIONA: Vertrauensleiste",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Kleine Überschrift (optional)"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Anordnung",
      "options": [
        {
          "value": "stack",
          "label": "Symbol über Text"
        },
        {
          "value": "row",
          "label": "Symbol neben Text"
        }
      ],
      "default": "stack"
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "Goldene Linien oben/unten",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Vorteil",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Symbol",
          "options": [
            {
              "value": "truck",
              "label": "Versand"
            },
            {
              "value": "germany",
              "label": "Standort / Deutschland"
            },
            {
              "value": "return",
              "label": "Widerruf / Rückgabe"
            },
            {
              "value": "gift",
              "label": "Geschenk"
            },
            {
              "value": "lock",
              "label": "Sichere Zahlung"
            },
            {
              "value": "shield",
              "label": "Schutz / Qualität"
            },
            {
              "value": "heart_racket",
              "label": "Herz & Schläger"
            },
            {
              "value": "ball",
              "label": "Tennisball"
            },
            {
              "value": "sparkle",
              "label": "Glanz"
            },
            {
              "value": "mail",
              "label": "Kontakt"
            },
            {
              "value": "clock",
              "label": "Lieferzeit"
            },
            {
              "value": "leaf",
              "label": "Nachhaltig"
            }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Kostenloser Versand"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "innerhalb Deutschlands"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LUVIONA: Vertrauensleiste",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Kostenloser Versand",
            "text": "innerhalb Deutschlands"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "germany",
            "title": "Versand aus Deutschland",
            "text": "Lieferzeit 2–4 Werktage"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "return",
            "title": "14 Tage Widerruf",
            "text": "gesetzliches Widerrufsrecht"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "gift",
            "title": "Geschenkverpackung",
            "text": "navy LUVIONA-Box auf Wunsch"
          }
        }
      ]
    }
  ]
}
{% endschema %}
