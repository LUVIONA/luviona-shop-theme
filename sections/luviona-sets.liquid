{%- comment -%}
  LUVIONA – Set-Vorschläge („Armband + Kette“, „Armband + Love Charm“).
  Ein Set-Preis wird nur angezeigt, wenn er im Block eingetragen ist – sonst die Einzelpreise.
{%- endcomment -%}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="luviona-sets color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" style="--luviona-sets-columns: {{ section.blocks.size | at_most: 3 | at_least: 1 }};">
  <div class="page-width">
    <div class="center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="luviona-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    <div class="luviona-sets__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p1 = block.settings.product_1
          assign p2 = block.settings.product_2
        -%}
        <div class="luviona-set{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h3 class="h3">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          <div class="luviona-set__products">
            {%- for i in (1..2) -%}
              {%- if i == 1 -%}{%- assign sp = p1 -%}{%- else -%}{%- assign sp = p2 -%}{%- endif -%}
              {%- if i == 2 -%}<span class="luviona-set__plus" aria-hidden="true">+</span>{%- endif -%}
              <div class="luviona-set__product">
                {%- if sp != blank -%}
                  <a href="{{ sp.url }}">
                    {%- if sp.featured_media -%}
                      {{ sp.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 300, 400, 600', sizes: '(min-width: 990px) 20vw, 40vw', alt: sp.featured_media.alt | escape }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                    <p class="luviona-set__product-title">{{ sp.title | escape }}</p>
                    <div class="luviona-set__price">{% render 'price', product: sp %}</div>
                  </a>
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  <p class="luviona-set__product-title">{{ 'luviona.sets.choose_product' | t }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
          {%- if block.settings.set_price != blank -%}
            <p class="luviona-set__sum">
              <strong>{{ block.settings.set_price | escape }}</strong>
              {% render 'luviona-price-note', style: 'compact' %}
            </p>
          {%- elsif p1 != blank and p2 != blank -%}
            {%- assign sum = p1.price | plus: p2.price -%}
            <p class="luviona-set__sum">
              {{ 'luviona.sets.together' | t }} <strong>{{ sum | money }}</strong>
              {% render 'luviona-price-note', style: 'compact' %}
            </p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="caption">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.link != blank and block.settings.link_label != blank -%}
            <a class="button button--secondary" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LUVIONA: Set-Vorschläge",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Überschrift",
      "default": "Kombinieren"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "Schöner zu zweit"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Größe der Überschrift",
      "options": [
        {
          "value": "h2",
          "label": "Klein"
        },
        {
          "value": "h1",
          "label": "Mittel"
        },
        {
          "value": "h0",
          "label": "Groß"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Armband und Kette im gleichen Design – oder dein Lieblingsarmband mit dem Love Charm. Jedes Teil ist einzeln bestellbar.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "set",
      "name": "Set",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Match Point Set"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Produkt 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Produkt 2"
        },
        {
          "type": "text",
          "id": "set_price",
          "label": "Set-Preis (nur eintragen, wenn festgelegt, z. B. „59,90 €“)"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Hinweis"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Button-Text",
          "default": "Zur Kollektion"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button-Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LUVIONA: Set-Vorschläge",
      "blocks": [
        {
          "type": "set",
          "settings": {
            "title": "Match Point Armband + Kette"
          }
        },
        {
          "type": "set",
          "settings": {
            "title": "Armband + Love Charm"
          }
        }
      ]
    }
  ]
}
{% endschema %}
