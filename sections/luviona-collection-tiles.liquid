{%- comment -%}
  LUVIONA – Kollektions-Kacheln: Produktlinien mit Bild, Name, kurzer Geschichte und Link.
  Mobil horizontal wischbar.
{%- endcomment -%}
{% render 'luviona-section-padding', section: section %}
<div class="luviona-tiles color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="luviona-section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="luviona-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="luviona-section-head__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="luviona-section-head__text rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <ul class="luviona-tiles__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign link = block.settings.link | default: p.url
          assign media = p.featured_media
          if block.settings.media_index > 1 and p.media.size >= block.settings.media_index
            assign idx = block.settings.media_index | minus: 1
            assign media = p.media[idx]
          endif
        -%}
        <li class="luviona-tile{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}{% if settings.animations_reveal_on_scroll %} data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}>
          <a class="luviona-tile__link" href="{{ link | default: '#' }}">
            <div class="luviona-tile__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 30vw, 75vw' }}
              {%- elsif media -%}
                {{ media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 30vw, 75vw', alt: media.alt | escape }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="luviona-tile__body">
              {%- if block.settings.kicker != blank -%}<p class="luviona-tile__kicker">{{ block.settings.kicker | escape }}</p>{%- endif -%}
              <h3 class="luviona-tile__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}<p class="luviona-tile__text">{{ block.settings.text | escape }}</p>{%- endif -%}
              {%- if block.settings.link_label != blank -%}<span class="luviona-link-arrow">{{ block.settings.link_label | escape }}</span>{%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "LUVIONA: Kollektionen",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "Die Kollektion" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Drei Linien, <em>ein Gefühl</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand oben", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand unten", "default": 64 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Kachel",
      "settings": [
        { "type": "product", "id": "product", "label": "Produkt (liefert Bild und Link)" },
        { "type": "range", "id": "media_index", "min": 1, "max": 10, "step": 1, "label": "Welches Produktbild", "default": 1 },
        { "type": "image_picker", "id": "image", "label": "Eigenes Bild (optional)" },
        { "type": "text", "id": "kicker", "label": "Zeile über dem Titel", "default": "Armband" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Court Classic" },
        { "type": "text", "id": "text", "label": "Kurztext", "default": "" },
        { "type": "text", "id": "link_label", "label": "Linktext", "default": "Entdecken" },
        { "type": "url", "id": "link", "label": "Link (sonst Produkt)" }
      ]
    }
  ],
  "presets": [ { "name": "LUVIONA: Kollektionen", "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ] } ]
}
{% endschema %}
