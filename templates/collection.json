{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_description": true,
        "show_collection_image": false,
        "color_scheme": "scheme-1"
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 12,
        "columns_desktop": 3,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "quick_add": "none",
        "enable_filtering": true,
        "filter_type": "horizontal",
        "enable_sorting": true,
        "columns_mobile": "2",
        "padding_top": 24,
        "padding_bottom": 72
      }
    },
    "trust": {
      "type": "luviona-trust-bar",
      "blocks": {
        "t1": {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Kostenloser Versand",
            "text": "innerhalb Deutschlands"
          }
        },
        "t2": {
          "type": "item",
          "settings": {
            "icon": "return",
            "title": "14 Tage Widerruf",
            "text": "gesetzliches Widerrufsrecht"
          }
        },
        "t3": {
          "type": "item",
          "settings": {
            "icon": "gift",
            "title": "Geschenkverpackung",
            "text": "navy LUVIONA-Box auf Wunsch"
          }
        },
        "t4": {
          "type": "item",
          "settings": {
            "icon": "lock",
            "title": "Sichere Zahlung",
            "text": "PayPal, Kreditkarte, Klarna, Apple Pay"
          }
        }
      },
      "block_order": [
        "t1",
        "t2",
        "t3",
        "t4"
      ],
      "settings": {
        "heading": "",
        "layout": "stack",
        "show_borders": true,
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
  "order": [
    "banner",
    "product-grid",
    "trust"
  ]
}
