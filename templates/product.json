            "default_manufacturer_address": "[PLATZHALTER: Straße Hausnummer]\n[PLATZHALTER: PLZ Ort]\nDeutschland",
            "default_manufacturer_contact": "info@luviona.de",
            "default_eu_responsible": "",
            "default_warnings": "Enthält Kleinteile – nicht für Kinder unter 3 Jahren geeignet. Verschluckungsgefahr. Kein Spielzeug. Von Hitze, Feuchtigkeit, Parfum und Kosmetik fernhalten.",
            "footnote": "",
            "open_by_default": false
          }
        },
        "kosmetik": {
          "type": "luviona_kosmetik",
          "settings": {
            "heading": "Inhaltsstoffe & Kosmetik-Angaben",
