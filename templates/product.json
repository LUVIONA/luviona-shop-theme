            "heading": "Pflegehinweise",
            "metafield_key": "pflege",
            "icon": "washing",
            "content": "<p>Vor dem Duschen, Schwimmen und Sport abnehmen. Kontakt mit Parfum, Cremes und Wasser vermeiden. Mit einem weichen, trockenen Tuch reinigen und in der LUVIONA-Box aufbewahren.</p>",
            "placeholder": "",
            "open_by_default": false
          }
        },
        "gpsr": {
          "type": "luviona_gpsr",
