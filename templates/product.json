            "open_by_default": false
          }
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Versand & Widerruf",
            "icon": "truck",
            "content": "<p>Versandkostenfrei innerhalb Deutschlands, Versand aus Deutschland. Lieferzeit 2–4 Werktage. Du hast 14 Tage Widerrufsrecht – ganz einfach über den Button „Vertrag widerrufen“ im Footer. Details in unserer <a href=\"/policies/shipping-policy\">Versandinformation</a> und der <a href=\"/policies/refund-policy\">Widerrufsbelehrung</a>.</p>"
          }
